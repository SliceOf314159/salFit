<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.salfit.controllers.LoginController"
           styleClass="auth-page">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <VBox alignment="CENTER" spacing="0">

        <!-- Logo -->
        <VBox styleClass="auth-logo" alignment="CENTER" spacing="4">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Sal" styleClass="auth-logo-text"/>
                <Label text="Fit" styleClass="auth-logo-accent"/>
            </HBox>
            <Label text="System zarządzania obiektem fitness" styleClass="auth-subtitle"/>
        </VBox>

        <!-- Two login cards side by side -->
        <HBox spacing="24" alignment="CENTER">

            <!-- Admin card -->
            <VBox styleClass="auth-card" spacing="0">
                <Label text="Logowanie — Administrator" styleClass="auth-title"/>
                <Label text="Dostęp do pełnego panelu zarządzania."
                       styleClass="auth-desc" wrapText="true"/>

                <Label fx:id="adminError" styleClass="auth-error" wrapText="true"
                       managed="false" visible="false"/>

                <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                    <Label text="LOGIN" styleClass="field-label"/>
                    <TextField fx:id="adminLogin" styleClass="field"
                               promptText="Podaj swój login"/>
                </VBox>
                <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                    <Label text="HASŁO" styleClass="field-label"/>
                    <PasswordField fx:id="adminPassword" styleClass="field"
                                   promptText="Podaj swoje hasło"/>
                </VBox>

                <Button text="Zaloguj" styleClass="btn,btn-primary"
                        maxWidth="Infinity" onAction="#loginAdmin"
                        style="-fx-padding: 11 18 11 18; -fx-margin-top: 8;"/>

                <HBox styleClass="auth-footer" alignment="CENTER" style="-fx-padding: 14 0 0 0;">
                    <Hyperlink text="Zapomniałem hasła" styleClass="auth-link"
                               onAction="#goForgotPassword"/>
                </HBox>
            </VBox>

            <!-- Trainer card -->
            <VBox styleClass="auth-card" spacing="0">
                <Label text="Logowanie — Trener" styleClass="auth-title"/>
                <Label text="Dostęp do własnego grafiku i profilu."
                       styleClass="auth-desc" wrapText="true"/>

                <Label fx:id="trainerError" styleClass="auth-error" wrapText="true"
                       managed="false" visible="false"/>

                <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                    <Label text="LOGIN" styleClass="field-label"/>
                    <TextField fx:id="trainerLogin" styleClass="field"
                               promptText="Podaj swój login"/>
                </VBox>
                <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                    <Label text="HASŁO" styleClass="field-label"/>
                    <PasswordField fx:id="trainerPassword" styleClass="field"
                                   promptText="Podaj swoje hasło"/>
                </VBox>

                <Button text="Zaloguj" styleClass="btn,btn-success"
                        maxWidth="Infinity" onAction="#loginTrainer"
                        style="-fx-padding: 11 18 11 18;"/>

                <HBox styleClass="auth-footer" alignment="CENTER" style="-fx-padding: 14 0 0 0;">
                    <Hyperlink text="Zapomniałem hasła" styleClass="auth-link"
                               onAction="#goForgotPassword"/>
                </HBox>
            </VBox>

        </HBox><!-- /.login-panels -->
    </VBox>
</StackPane>
