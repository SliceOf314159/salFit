<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.TrainerAktywnoscController"
      styleClass="main-content" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <HBox styleClass="page-header" alignment="CENTER_LEFT">
        <Label text="Moja aktywność" styleClass="page-title"/>
    </HBox>

    <!-- Stat cards -->
    <HBox spacing="16" style="-fx-padding: 0 0 24 0;" alignment="CENTER_LEFT">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statWeek" text="4" styleClass="stat-value"/>
            <Label text="Zajęcia w tym tygodniu" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statTotal" text="156"
                   styleClass="stat-value,stat-value-green"/>
            <Label text="Łącznie uczestników" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statObloz" text="73%"
                   styleClass="stat-value,stat-value-green"/>
            <Label text="Średnie obłożenie" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- Monthly breakdown table -->
    <VBox styleClass="card" spacing="0">
        <Label text="Statystyki miesięczne" styleClass="card-title"/>
        <TableView fx:id="aktywnoscTable" VBox.vgrow="ALWAYS"
                   style="-fx-pref-height: 320px;">
            <columns>
                <TableColumn text="MIESIĄC"          fx:id="colMiesiac"      prefWidth="140"/>
                <TableColumn text="LICZBA ZAJĘĆ"      fx:id="colLiczbaZajec" prefWidth="140"/>
                <TableColumn text="UCZESTNICY ŁĄCZNIE" fx:id="colUczestnicy" prefWidth="160"/>
                <TableColumn text="OBŁOŻENIE"         fx:id="colObloz"       prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="Brak danych" style="-fx-text-fill: -sf-muted;"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
