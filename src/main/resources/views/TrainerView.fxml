<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.salfit.controllers.TrainerShellController"
            prefWidth="1280" prefHeight="800">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <!-- ── Topbar ────────────────────────────────────────────────── -->
    <top>
        <HBox styleClass="topbar">
            <HBox spacing="0" alignment="CENTER_LEFT">
                <Label text="Sal" styleClass="topbar-logo"/>
                <Label text="Fit" styleClass="topbar-logo-accent"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="topbarDate" styleClass="topbar-user"/>
            <Label fx:id="topbarUser" text="Anna Kowalska (Trener)"
                   styleClass="topbar-user"/>
            <Button text="Wyloguj" styleClass="topbar-link"
                    onAction="#logout"/>
            <Button text="Zmień hasło" styleClass="topbar-link"
                    onAction="#goChangePassword"/>
        </HBox>
    </top>

    <!-- ── Trainer sidebar ───────────────────────────────────────── -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="PANEL TRENERA" styleClass="sidebar-section"/>
            <Button fx:id="btnMojeZajecia" text="Moje zajęcia"
                    styleClass="sidebar-item" onAction="#showGrafik"
                    maxWidth="Infinity"/>
            <Button fx:id="btnProfil" text="Mój profil"
                    styleClass="sidebar-item" onAction="#showProfil"
                    maxWidth="Infinity"/>
            <Button fx:id="btnAktywnosc" text="Moja aktywność"
                    styleClass="sidebar-item" onAction="#showAktywnosc"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ── Content area ──────────────────────────────────────────── -->
    <center>
        <ScrollPane fx:id="mainScroll" fitToWidth="true"
                    styleClass="main-scroll" hbarPolicy="NEVER">
            <StackPane fx:id="contentArea" styleClass="main-content"
                       minWidth="600"/>
        </ScrollPane>
    </center>

</BorderPane>
