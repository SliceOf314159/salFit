<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.TrenerController"
      styleClass="main-content" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <!-- Page header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT">
        <Label text="Zarządzanie trenerami" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Dodaj trenera" styleClass="btn,btn-primary"
                onAction="#onDodajTrener"/>
    </HBox>

    <!-- Card with search + table -->
    <VBox styleClass="card" spacing="0">

        <!-- Toolbar -->
        <HBox styleClass="toolbar" alignment="CENTER_LEFT">
            <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8">
                <Label text="🔍" style="-fx-text-fill: -sf-muted;"/>
                <TextField fx:id="searchField" styleClass="search-field"
                           promptText="Szukaj trenera…"
                           onKeyReleased="#onSearch" HBox.hgrow="ALWAYS"/>
            </HBox>
        </HBox>

        <!-- Table -->
        <TableView fx:id="trenerTable" VBox.vgrow="ALWAYS"
                   style="-fx-pref-height: 400px;">
            <columns>
                <TableColumn text="ID"               fx:id="colId"     prefWidth="70"/>
                <TableColumn text="IMIĘ I NAZWISKO"  fx:id="colNazwa"  prefWidth="200"/>
                <TableColumn text="SPECJALIZACJA"    fx:id="colSpec"   prefWidth="180"/>
                <TableColumn text="E-MAIL"           fx:id="colEmail"  prefWidth="180"/>
                <TableColumn text="STATUS"           fx:id="colStatus" prefWidth="100"/>
                <TableColumn text="AKCJE"            fx:id="colAkcje"  prefWidth="160"/>
            </columns>
            <placeholder>
                <Label text="Brak danych" style="-fx-text-fill: -sf-muted;"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
