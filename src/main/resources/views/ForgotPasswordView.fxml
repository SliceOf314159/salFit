<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.salfit.controllers.ForgotPasswordController"
           styleClass="auth-page">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <VBox alignment="CENTER" spacing="0">

        <VBox styleClass="auth-logo" alignment="CENTER" spacing="0">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Sal" styleClass="auth-logo-text"/>
                <Label text="Fit" styleClass="auth-logo-accent"/>
            </HBox>
        </VBox>

        <VBox styleClass="auth-card" spacing="0">
            <Label text="Resetowanie hasła" styleClass="auth-title"/>
            <Label text="Podaj adres e-mail powiązany z Twoim kontem. Wyślemy na niego link umożliwiający ustawienie nowego hasła."
                   styleClass="auth-desc" wrapText="true"/>

            <!-- Reset form (hidden after submission) -->
            <VBox fx:id="resetForm" spacing="0">
                <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                    <HBox spacing="2">
                        <Label text="ADRES E-MAIL" styleClass="field-label"/>
                        <Label text="*" styleClass="req"/>
                    </HBox>
                    <TextField fx:id="emailField" styleClass="field"
                               promptText="adres@email.pl"/>
                </VBox>
                <Button text="Wyślij link resetujący" styleClass="btn,btn-primary"
                        maxWidth="Infinity" onAction="#submitReset"
                        style="-fx-padding: 11 18 11 18;"/>
            </VBox>

            <!-- Success message (hidden until submitted) -->
            <VBox fx:id="resetSuccess" visible="false" managed="false" spacing="12">
                <Label text="Link do resetowania hasła został wysłany na podany adres e-mail. Sprawdź swoją skrzynkę i kliknij link w wiadomości."
                       styleClass="auth-success" wrapText="true"/>
                <Button text="← Wróć do logowania" styleClass="btn,btn-ghost"
                        maxWidth="Infinity" onAction="#goLogin"/>
            </VBox>

            <HBox styleClass="auth-footer" alignment="CENTER" style="-fx-padding: 14 0 0 0;">
                <Hyperlink text="← Wróć do logowania" styleClass="auth-link"
                           onAction="#goLogin"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>
