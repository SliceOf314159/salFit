<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.salfit.controllers.ChangePasswordController"
           styleClass="auth-page">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <VBox alignment="CENTER" spacing="0">

        <VBox styleClass="auth-logo" alignment="CENTER" spacing="0">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Sal" styleClass="auth-logo-text"/>
                <Label text="Fit" styleClass="auth-logo-accent"/>
            </HBox>
        </VBox>

        <VBox styleClass="auth-card" spacing="0">
            <Label text="Zmiana hasła" styleClass="auth-title"/>
            <Label text="Aby zmienić hasło, najpierw potwierdź bieżące."
                   styleClass="auth-desc" wrapText="true"/>

            <Label fx:id="errorLabel" styleClass="auth-error" wrapText="true"
                   managed="false" visible="false"/>

            <!-- Change password form -->
            <VBox fx:id="changeForm" spacing="0">
                <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                    <HBox spacing="2">
                        <Label text="BIEŻĄCE HASŁO" styleClass="field-label"/>
                        <Label text="*" styleClass="req"/>
                    </HBox>
                    <PasswordField fx:id="currentPw" styleClass="field"
                                   promptText="Bieżące hasło"/>
                </VBox>

                <VBox spacing="5" style="-fx-padding: 0 0 4 0;">
                    <HBox spacing="2">
                        <Label text="NOWE HASŁO" styleClass="field-label"/>
                        <Label text="*" styleClass="req"/>
                    </HBox>
                    <PasswordField fx:id="newPw" styleClass="field"
                                   promptText="Min. 8 znaków" onKeyReleased="#updateStrength"/>
                    <!-- Strength bar -->
                    <StackPane style="-fx-padding: 4 0 0 0;">
                        <Pane styleClass="strength-bar-track"/>
                        <Pane fx:id="strengthFill"
                              style="-fx-background-radius: 2; -fx-pref-height: 4px; -fx-max-height: 4px;"
                              maxWidth="0"/>
                    </StackPane>
                    <Label fx:id="strengthLabel" styleClass="strength-hint"
                           text="Siła hasła: —"/>
                </VBox>

                <VBox spacing="5" style="-fx-padding: 10 0 14 0;">
                    <HBox spacing="2">
                        <Label text="POWTÓRZ NOWE HASŁO" styleClass="field-label"/>
                        <Label text="*" styleClass="req"/>
                    </HBox>
                    <PasswordField fx:id="confirmPw" styleClass="field"
                                   promptText="Powtórz nowe hasło"/>
                </VBox>

                <Button text="Zmień hasło" styleClass="btn,btn-primary"
                        maxWidth="Infinity" onAction="#submitChange"
                        style="-fx-padding: 11 18 11 18;"/>
            </VBox>

            <!-- Success message -->
            <VBox fx:id="changeSuccess" visible="false" managed="false" spacing="12">
                <Label text="Hasło zostało zmienione pomyślnie."
                       styleClass="auth-success" wrapText="true"/>
                <Button text="← Powrót do logowania" styleClass="btn,btn-ghost"
                        maxWidth="Infinity" onAction="#goLogin"/>
            </VBox>

            <HBox styleClass="auth-footer" alignment="CENTER" style="-fx-padding: 14 0 0 0;">
                <Hyperlink text="← Wróć do logowania" styleClass="auth-link"
                           onAction="#goLogin"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>
