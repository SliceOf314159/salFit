<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.RaportController"
      styleClass="main-content" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <HBox styleClass="page-header" alignment="CENTER_LEFT">
        <Label text="Raporty" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="8">
            <Button text="↓ Eksport CSV" styleClass="btn,btn-secondary"
                    onAction="#onEksportCSV"/>
            <Button text="↓ Eksport TXT" styleClass="btn,btn-ghost"
                    onAction="#onEksportTXT"/>
        </HBox>
    </HBox>

    <!-- Summary stat cards -->
    <HBox spacing="16" style="-fx-padding: 0 0 24 0;" alignment="CENTER_LEFT">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statZajecia" text="12" styleClass="stat-value"/>
            <Label text="Zajęć w tym tygodniu" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statCzlonkowie" text="38" styleClass="stat-value"/>
            <Label text="Aktywnych członków" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statWygasajace" text="5"
                   styleClass="stat-value,stat-value-warn"/>
            <Label text="Karnety wygasają wkrótce" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- Two-column report cards -->
    <HBox spacing="20" alignment="TOP_LEFT">
        <!-- Room occupancy -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <Label text="Obłożenie sal — tydzień bieżący"
                   styleClass="card-title"/>
            <!-- Sala A -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Sala A" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaA" progress="0.78"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar"/>
                <Label text="78%" styleClass="progress-pct"/>
            </HBox>
            <!-- Sala B -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Sala B" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaB" progress="0.50"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar"/>
                <Label text="50%" styleClass="progress-pct"/>
            </HBox>
            <!-- Sala C -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Sala C" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaC" progress="0.20"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-danger"/>
                <Label text="20%" styleClass="progress-pct"/>
            </HBox>
            <!-- Sala D -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Sala D" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaD" progress="0.65"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar"/>
                <Label text="65%" styleClass="progress-pct"/>
            </HBox>
        </VBox>

        <!-- Trainer activity -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <Label text="Aktywność trenerów" styleClass="card-title"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Anna K." styleClass="progress-label"/>
                <ProgressBar fx:id="barT1" progress="0.90"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label text="9 zaj." styleClass="progress-pct"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Piotr N." styleClass="progress-label"/>
                <ProgressBar fx:id="barT2" progress="0.60"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label text="6 zaj." styleClass="progress-pct"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Maria W." styleClass="progress-label"/>
                <ProgressBar fx:id="barT3" progress="0.40"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label text="4 zaj." styleClass="progress-pct"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Tomasz B." styleClass="progress-label"/>
                <ProgressBar fx:id="barT4" progress="0.50"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label text="5 zaj." styleClass="progress-pct"/>
            </HBox>
        </VBox>
    </HBox>

</VBox>
