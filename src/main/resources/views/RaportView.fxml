<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.RaportController"
      styleClass="main-content" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <HBox styleClass="page-header" alignment="CENTER_LEFT">
        <Label text="Raporty" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="8">
            <Button text="↓ Eksport CSV" styleClass="btn,btn-secondary"
                    onAction="#onEksportCSV"/>
            <Button text="↓ Eksport TXT" styleClass="btn,btn-secondary"
                    onAction="#onEksportTXT"/>
        </HBox>
    </HBox>

    <!-- Summary stat cards -->
    <HBox spacing="16" style="-fx-padding: 0 0 24 0;" alignment="CENTER_LEFT">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statZajecia" text="12" styleClass="stat-value"/>
            <Label text="Zajęć w tym tygodniu" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statCzlonkowie" text="38" styleClass="stat-value"/>
            <Label text="Aktywnych członków" styleClass="stat-label"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label fx:id="statWygasajace" text="5"
                   styleClass="stat-value,stat-value-warn"/>
            <Label text="Karnety wygasają wkrótce" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- Two-column report cards -->
    <HBox spacing="20" alignment="TOP_LEFT">
        <!-- Room occupancy -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <Label text="Obłożenie sal — tydzień bieżący"
                   styleClass="card-title"/>
            <!-- Sala A -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelSalaA" text="Sala A" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaA"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar"/>
                <Label fx:id="pctSalaA" styleClass="progress-pct"/>
            </HBox>
            <!-- Sala B -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelSalaB" text="Sala B" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaB"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar"/>
                <Label fx:id="pctSalaB" styleClass="progress-pct"/>
            </HBox>
            <!-- Sala C -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelSalaC" text="Sala C" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaC"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-danger"/>
                <Label fx:id="pctSalaC" styleClass="progress-pct"/>
            </HBox>
            <!-- Sala D -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelSalaD" text="Sala D" styleClass="progress-label"/>
                <ProgressBar fx:id="barSalaD"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar"/>
                <Label fx:id="pctSalaD" styleClass="progress-pct"/>
            </HBox>
        </VBox>

        <!-- Trainer activity -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <Label text="Aktywność trenerów" styleClass="card-title"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelT1" styleClass="progress-label"/>
                <ProgressBar fx:id="barT1"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label fx:id="pctT1" styleClass="progress-pct"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelT2" styleClass="progress-label"/>
                <ProgressBar fx:id="barT2"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label fx:id="pctT2" styleClass="progress-pct"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelT3" styleClass="progress-label"/>
                <ProgressBar fx:id="barT3"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label fx:id="pctT3" styleClass="progress-pct"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="labelT4" styleClass="progress-label"/>
                <ProgressBar fx:id="barT4"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             styleClass="progress-bar,progress-bar-teal"/>
                <Label fx:id="pctT4" styleClass="progress-pct"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Monthly breakdown -->
    <Region prefHeight="20"/>
    <VBox styleClass="card" spacing="8">
        <Label text="Statystyki miesięczne" styleClass="card-title"/>
        <TableView fx:id="monthlyTable" VBox.vgrow="ALWAYS"
                   style="-fx-pref-height: 280px;">
            <columns>
                <TableColumn text="MIESIĄC"           fx:id="colMiesiac"     prefWidth="140"/>
                <TableColumn text="LICZBA ZAJĘĆ"      fx:id="colLiczbaZajec" prefWidth="140"/>
                <TableColumn text="UCZESTNICY ŁĄCZNIE" fx:id="colUczestnicy" prefWidth="160"/>
                <TableColumn text="OBŁOŻENIE"         fx:id="colObloz"       prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="Brak danych" style="-fx-text-fill: -sf-muted;"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>
