<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.salfit.controllers.AddEditTrenerDialogController"
            styleClass="dialog-root" prefWidth="820">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: -sf-bg;">
            <VBox spacing="16" style="-fx-padding: 24;">

                <!-- Main form card -->
                <VBox styleClass="card" spacing="16">
                    <Label fx:id="formError" styleClass="auth-error" wrapText="true"
                           minHeight="22" visible="false"/>
                    <Label fx:id="draftHint" styleClass="field-hint" visible="false" managed="false"/>
                    <!-- Row 1: imie + nazwisko -->
                    <HBox spacing="16" alignment="TOP_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                            <HBox spacing="2"><Label text="IMIę" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldImie" styleClass="field" maxWidth="Infinity" promptText="Imię"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                            <HBox spacing="2"><Label text="NAZWISKO" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldNazwisko" styleClass="field" maxWidth="Infinity" promptText="Nazwisko"/>
                        </VBox>
                    </HBox>
                    <!-- Row 2: email + telefon -->
                    <HBox spacing="16" alignment="TOP_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                            <HBox spacing="2"><Label text="E-MAIL" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldEmail" styleClass="field" maxWidth="Infinity"
                                       promptText="adres@email.pl"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                            <HBox spacing="2"><Label text="NUMER TELEFONU" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldTelefon" styleClass="field" maxWidth="Infinity"
                                       promptText="000 000 000"/>
                        </VBox>
                    </HBox>
                    <!-- Specialisations -->
                    <VBox spacing="5">
                        <Label text="SPECJALIZACJE" styleClass="field-label"/>
                        <HBox spacing="16">
                            <CheckBox fx:id="cbGrupowy"    text="Trening grupowy"
                                      styleClass="checkbox-item"/>
                            <CheckBox fx:id="cbPersonalny" text="Trening personalny"
                                      styleClass="checkbox-item"/>
                            <CheckBox fx:id="cbOnline"     text="Konsultacja online"
                                      styleClass="checkbox-item"/>
                        </HBox>
                    </VBox>
                    <!-- Poziom doświadczenia -->
                    <VBox spacing="5">
                        <Label text="POZIOM DOŚWIADCZENIA" styleClass="field-label"/>
                        <ComboBox fx:id="fieldPoziom" styleClass="field" prefWidth="0" minWidth="0" maxWidth="Infinity"/>
                    </VBox>
                    <!-- Password (add mode only) -->
                    <VBox fx:id="passwordSection" spacing="5">
                        <HBox spacing="2"><Label text="HASŁO" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <PasswordField fx:id="fieldHaslo" styleClass="field" maxWidth="Infinity"
                                       promptText="Min. 8 znaków"/>
                    </VBox>
                </VBox>

                <!-- Form actions -->
                <HBox styleClass="form-actions" alignment="CENTER_LEFT">
                    <Button fx:id="btnDraft" text="Zachowaj wersję roboczą" styleClass="btn,btn-ghost"
                            onAction="#onZachowajWersjeRobocza"/>
                    <Button fx:id="btnUsun" text="Usuń trenera"
                            styleClass="btn,btn-danger"
                            managed="false" visible="false"
                            onAction="#onUsun"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Anuluj" styleClass="btn,btn-ghost" onAction="#onCancel"/>
                    <Button fx:id="btnSave" text="Zapisz"
                            styleClass="btn,btn-primary" onAction="#onSave"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
