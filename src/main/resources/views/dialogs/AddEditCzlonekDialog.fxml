<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.AddEditCzlonekDialogController"
      styleClass="dialog-root" prefWidth="820" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: -sf-bg;" VBox.vgrow="ALWAYS">
        <VBox style="-fx-padding: 24;" spacing="16">

            <!-- Main form card -->
            <VBox styleClass="card" spacing="16">

                <Label fx:id="formError" styleClass="auth-error" wrapText="true"
                       minHeight="22" visible="false"/>
                <Label fx:id="draftHint" styleClass="field-hint" visible="false" managed="false"/>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <HBox spacing="2"><Label text="IMIę" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <TextField fx:id="fieldImie" styleClass="field" maxWidth="Infinity" promptText="Imię"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <HBox spacing="2"><Label text="NAZWISKO" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <TextField fx:id="fieldNazwisko" styleClass="field" maxWidth="Infinity" promptText="Nazwisko"/>
                    </VBox>
                </HBox>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <HBox spacing="2"><Label text="E-MAIL" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <TextField fx:id="fieldEmail" styleClass="field" maxWidth="Infinity"
                                   promptText="adres@email.pl"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <Label text="NUMER TELEFONU" styleClass="field-label"/>
                        <TextField fx:id="fieldTelefon" styleClass="field" maxWidth="Infinity"
                                   promptText="000-000-000"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="DATA URODZENIA" styleClass="field-label"/>
                    <DatePicker fx:id="fieldDataUr" styleClass="field" prefWidth="0" minWidth="0" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <HBox styleClass="form-actions" alignment="CENTER_LEFT">
                <Button fx:id="btnDraft" text="Zachowaj wersję roboczą" styleClass="btn,btn-ghost"
                        onAction="#onZachowajWersjeRobocza"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Anuluj" styleClass="btn,btn-ghost" onAction="#onCancel"/>
                <Button fx:id="btnSave" text="Zapisz"
                        styleClass="btn,btn-primary" onAction="#onSave"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
