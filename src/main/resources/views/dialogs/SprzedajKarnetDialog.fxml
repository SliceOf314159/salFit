<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.SprzedajKarnetDialogController"
      styleClass="dialog-root" prefWidth="740" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: -sf-bg;" VBox.vgrow="ALWAYS">
        <HBox style="-fx-padding: 24;" spacing="24" alignment="TOP_LEFT">

            <!-- Form card -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">

                <Label fx:id="formError" styleClass="auth-error" wrapText="true"
                       minHeight="22" visible="false"/>

                <!-- Member selector -->
                <VBox spacing="5">
                    <HBox spacing="2">
                        <Label text="WYBIERZ KLUBOWICZA" styleClass="field-label"/>
                        <Label text="*" styleClass="req"/>
                    </HBox>
                    <HBox spacing="8">
                        <ComboBox fx:id="fieldCzlonek" styleClass="field"
                                  promptText="Wybierz…" HBox.hgrow="ALWAYS"
                                  prefWidth="0" minWidth="0" maxWidth="Infinity"/>
                        <Button text="+ Nowy" styleClass="btn,btn-secondary"
                                onAction="#onNowyCzlonek"/>
                    </HBox>
                </VBox>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <HBox spacing="2">
                            <Label text="RODZAJ KARNETU" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/>
                        </HBox>
                        <ComboBox fx:id="fieldRodzaj" styleClass="field"
                                  prefWidth="0" minWidth="0" maxWidth="Infinity" promptText="Wybierz…"
                                  onAction="#onRodzajChanged"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <Label text="METODA PŁATNOŚCI" styleClass="field-label"/>
                        <ComboBox fx:id="fieldPlatnosc" styleClass="field"
                                  prefWidth="0" minWidth="0" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <Label text="DATA ROZPOCZĘCIA" styleClass="field-label"/>
                        <DatePicker fx:id="fieldDataOd" styleClass="field"
                                    prefWidth="0" minWidth="0" maxWidth="Infinity" onAction="#onDataOdChanged"/>
                        <CheckBox text="Przedłuż od dnia wygaśnięcia"
                                  styleClass="checkbox-item"
                                  style="-fx-padding: 6 0 0 0;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
                        <Label text="DATA ZAKOŃCZENIA" styleClass="field-label"/>
                        <DatePicker fx:id="fieldDataDo" styleClass="field"
                                    prefWidth="0" minWidth="0" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox styleClass="form-actions" alignment="CENTER_LEFT">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Anuluj" styleClass="btn,btn-ghost"
                            onAction="#onCancel"/>
                    <Button text="Przedłuż" styleClass="btn,btn-secondary"
                            onAction="#onPrzedluz"/>
                    <Button text="Sprzedaj" styleClass="btn,btn-primary"
                            onAction="#onSprzedaj"/>
                </HBox>
            </VBox>

            <!-- Mini calendar -->
            <VBox styleClass="mini-cal" prefWidth="240" spacing="0">
                <HBox alignment="CENTER" spacing="10"
                      style="-fx-padding: 0 0 10 0;">
                    <Button text="‹" styleClass="mini-cal-nav"
                            onAction="#prevMonth"/>
                    <Label fx:id="calMonthLabel" text="Czerwiec 2026"
                           styleClass="mini-cal-month" HBox.hgrow="ALWAYS"
                           style="-fx-alignment: CENTER;"/>
                    <Button text="›" styleClass="mini-cal-nav"
                            onAction="#nextMonth"/>
                </HBox>
                <GridPane fx:id="calGrid" hgap="2" vgap="2" alignment="CENTER"/>
            </VBox>

        </HBox>
    </ScrollPane>
</VBox>
