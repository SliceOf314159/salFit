<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.AddEditZajeciaDialogController"
      styleClass="dialog-root" prefWidth="820" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                style="-fx-background-color: -sf-bg;" VBox.vgrow="ALWAYS">
        <HBox style="-fx-padding: 24;" spacing="24" alignment="TOP_LEFT">

            <!-- Left card: basic info -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                <Label text="Podstawowe informacje" styleClass="card-title"/>

                <VBox spacing="5">
                    <HBox spacing="2"><Label text="NAZWA ZAJĘĆ" styleClass="field-label"/>
                        <Label text="*" styleClass="req"/></HBox>
                    <TextField fx:id="fieldNazwa" styleClass="field"
                               promptText="np. Yoga poranny"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <HBox spacing="2"><Label text="RODZAJ ZAJĘĆ" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <ComboBox fx:id="fieldRodzaj" styleClass="field"
                                  maxWidth="Infinity" promptText="Wybierz…"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <HBox spacing="2"><Label text="PRZYPISZ TRENERA" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <ComboBox fx:id="fieldTrener" styleClass="field"
                                  maxWidth="Infinity" promptText="Wybierz…"/>
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <HBox spacing="2"><Label text="SALA" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <ComboBox fx:id="fieldSala" styleClass="field"
                                  maxWidth="Infinity" promptText="Wybierz…"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="POZIOM TRUDNOŚCI" styleClass="field-label"/>
                        <ComboBox fx:id="fieldPoziom" styleClass="field"
                                  maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <HBox spacing="2"><Label text="TERMIN" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <DatePicker fx:id="fieldData" styleClass="field"
                                    maxWidth="Infinity"/>
                        <CheckBox text="Powtarzalność" styleClass="checkbox-item"
                                  style="-fx-padding: 6 0 0 0;"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="LIMIT UCZESTNIKÓW" styleClass="field-label"/>
                        <HBox styleClass="stepper" alignment="CENTER">
                            <Button text="−" styleClass="stepper-btn" onAction="#stepLimitDown"/>
                            <TextField fx:id="fieldLimit" styleClass="stepper-value"
                                       text="35" alignment="CENTER"/>
                            <Button text="+" styleClass="stepper-btn" onAction="#stepLimitUp"/>
                        </HBox>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="CZAS TRWANIA" styleClass="field-label"/>
                    <HBox styleClass="stepper" alignment="CENTER">
                        <Button text="−" styleClass="stepper-btn" onAction="#stepCzasDown"/>
                        <TextField fx:id="fieldCzas" styleClass="stepper-value"
                                   text="60" alignment="CENTER"/>
                        <Button text="+" styleClass="stepper-btn" onAction="#stepCzasUp"/>
                    </HBox>
                    <Label text="minut" styleClass="field-hint"/>
                </VBox>
            </VBox>

            <!-- Right card: description -->
            <VBox styleClass="card" prefWidth="340" spacing="16">
                <Label text="Opis i wymagania" styleClass="card-title"/>

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="OPIS ZAJĘĆ" styleClass="field-label"/>
                    <TextArea fx:id="fieldOpis" styleClass="field"
                              promptText="Opis zajęć…" prefRowCount="4"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="WYMAGANIA SPRZĘTOWE I TECHNICZNE"
                           styleClass="field-label"/>
                    <TextArea fx:id="fieldWymagania" styleClass="field"
                              promptText="np. Maty, liny…" prefRowCount="3"/>
                </VBox>

                <HBox styleClass="form-actions" alignment="CENTER_LEFT">
                    <Button text="Zachowaj wersję roboczą"
                            styleClass="btn,btn-ghost"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Anuluj" styleClass="btn,btn-ghost"
                            onAction="#onCancel"/>
                    <Button text="Zapisz" styleClass="btn,btn-primary"
                            onAction="#onSave"/>
                </HBox>
            </VBox>

        </HBox>
    </ScrollPane>
</VBox>
