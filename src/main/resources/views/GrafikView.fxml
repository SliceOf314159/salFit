<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salfit.controllers.GrafikController"
      styleClass="main-content" spacing="0">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <HBox styleClass="page-header" alignment="CENTER_LEFT">
        <Label text="Grafik zajęć" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Dodaj zajęcia" styleClass="btn,btn-primary"
                onAction="#onDodajZajecia"/>
    </HBox>

    <VBox styleClass="card" spacing="0">
        <!-- Calendar navigation row -->
        <HBox styleClass="cal-nav" alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 0 0 16 0;">
            <Button text="← Poprzedni" styleClass="btn,btn-ghost,btn-sm"
                    onAction="#onPoprzedniTydzien"/>
            <Label fx:id="weekLabel" text="Tydzień 19–23 maja 2026"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: -sf-navy;"
                   HBox.hgrow="ALWAYS"/>
            <Button text="Następny →" styleClass="btn,btn-ghost,btn-sm"
                    onAction="#onNastepnyTydzien"/>
        </HBox>

        <!-- Weekly grid -->
        <SplitPane fx:id="grafikGrid" style="-fx-background-color: -sf-white;"/>
    </VBox>
</VBox>
