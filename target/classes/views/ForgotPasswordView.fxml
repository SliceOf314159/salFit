<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.salfit.controllers.ForgotPasswordController"
           styleClass="auth-page">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <VBox alignment="CENTER" spacing="0">

        <VBox styleClass="auth-logo" alignment="CENTER" spacing="0">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Sal" styleClass="auth-logo-text"/>
                <Label text="Fit" styleClass="auth-logo-accent"/>
            </HBox>
        </VBox>

        <VBox styleClass="auth-card" spacing="16">
            <Label text="Zmiana hasła" styleClass="auth-title"/>
            <Label text="Aby zmienić hasło, skontaktuj się z administratorem systemu."
                   styleClass="auth-desc" wrapText="true"/>
            <Label text="Administrator może zresetować Twoje hasło bezpośrednio w panelu zarządzania."
                   styleClass="auth-desc" wrapText="true"/>
            <Button text="← Wróć do logowania" styleClass="btn,btn-primary"
                    maxWidth="Infinity" onAction="#goLogin"
                    style="-fx-padding: 11 18 11 18;"/>
        </VBox>

    </VBox>
</StackPane>
