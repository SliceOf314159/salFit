<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.salfit.controllers.MainController"
            prefWidth="1280" prefHeight="800">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <!-- ── Topbar ────────────────────────────────────────────────── -->
    <top>
        <HBox styleClass="topbar">
            <HBox spacing="0" alignment="CENTER_LEFT">
                <Label text="Sal" styleClass="topbar-logo"/>
                <Label text="Fit" styleClass="topbar-logo-accent"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="topbarUser" text="Jan Kowalski (admin)"
                   styleClass="topbar-user"/>
            <Button text="Wyloguj" styleClass="topbar-link"
                    onAction="#logout"/>
            <Button text="Zmień hasło" styleClass="topbar-link"
                    onAction="#goChangePassword"/>
        </HBox>
    </top>

    <!-- ── Sidebar ───────────────────────────────────────────────── -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="PANEL ADMINA" styleClass="sidebar-section"/>
            <Button fx:id="btnTrenerzy" text="Trenerzy"
                    styleClass="sidebar-item" onAction="#showTrenerView"
                    maxWidth="Infinity"/>
            <Button fx:id="btnSale" text="Sale"
                    styleClass="sidebar-item" onAction="#showSalaView"
                    maxWidth="Infinity"/>
            <Button fx:id="btnGrafik" text="Grafik"
                    styleClass="sidebar-item" onAction="#showGrafikView"
                    maxWidth="Infinity"/>
            <Label text="CZŁONKOWIE" styleClass="sidebar-section"/>
            <Button fx:id="btnCzlonkowie" text="Lista członków"
                    styleClass="sidebar-item" onAction="#showCzlonekView"
                    maxWidth="Infinity"/>
            <Button fx:id="btnKarnety" text="Karnety"
                    styleClass="sidebar-item" onAction="#showKarnetView"
                    maxWidth="Infinity"/>
            <Label text=" " styleClass="sidebar-section"/>
            <Button fx:id="btnRaporty" text="Raporty"
                    styleClass="sidebar-item" onAction="#showRaportView"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ── Content area ──────────────────────────────────────────── -->
    <center>
        <ScrollPane fx:id="mainScroll" fitToWidth="true"
                    styleClass="main-scroll" hbarPolicy="NEVER">
            <StackPane fx:id="contentArea" styleClass="main-content"
                       minWidth="600"/>
        </ScrollPane>
    </center>

</BorderPane>
