<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import java.net.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.salfit.controllers.AddEditTrenerDialogController"
            styleClass="dialog-root" prefWidth="820">
    <stylesheets><URL value="@/styles/main.css"/></stylesheets>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: -sf-bg;">
            <HBox spacing="24" style="-fx-padding: 24;" alignment="TOP_LEFT">

                <!-- Main form card -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                    <!-- Row 1 -->
                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2"><Label text="IMIę" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldImie" styleClass="field"
                                       promptText="Imię"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2"><Label text="NAZWISKO" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldNazwisko" styleClass="field"
                                       promptText="Nazwisko"/>
                        </VBox>
                    </HBox>
                    <!-- Row 2 -->
                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2"><Label text="E-MAIL" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldEmail" styleClass="field"
                                       promptText="adres@email.pl"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="2"><Label text="NUMER TELEFONU" styleClass="field-label"/>
                                <Label text="*" styleClass="req"/></HBox>
                            <TextField fx:id="fieldTelefon" styleClass="field"
                                       promptText="000 000 000"/>
                        </VBox>
                    </HBox>
                    <!-- Row 3 -->
                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="DATA URODZENIA" styleClass="field-label"/>
                            <DatePicker fx:id="fieldDataUr" styleClass="field"
                                        maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="PŁEĆ" styleClass="field-label"/>
                            <ComboBox fx:id="fieldPlec" styleClass="field"
                                      maxWidth="Infinity"
                                      promptText="Wybierz…"/>
                        </VBox>
                    </HBox>
                    <!-- Specialisations -->
                    <VBox spacing="5">
                        <Label text="SPECJALIZACJE" styleClass="field-label"/>
                        <HBox spacing="16">
                            <CheckBox fx:id="cbGrupowy"    text="Trening grupowy"
                                      styleClass="checkbox-item"/>
                            <CheckBox fx:id="cbPersonalny" text="Trening personalny"
                                      styleClass="checkbox-item"/>
                            <CheckBox fx:id="cbOnline"     text="Konsultacja online"
                                      styleClass="checkbox-item"/>
                        </HBox>
                    </VBox>
                    <!-- Row 4 -->
                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="POZIOM DOŚWIADCZENIA" styleClass="field-label"/>
                            <ComboBox fx:id="fieldPoziom" styleClass="field"
                                      maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="SOCIAL MEDIA" styleClass="field-label"/>
                            <TextField fx:id="fieldSocial" styleClass="field"
                                       promptText="https://instagram.com/…"/>
                        </VBox>
                    </HBox>
                    <!-- Bio -->
                    <VBox spacing="5">
                        <Label text="BIO" styleClass="field-label"/>
                        <TextArea fx:id="fieldBio" styleClass="field"
                                  promptText="Krótki opis trenera…"
                                  prefRowCount="3"/>
                    </VBox>
                    <!-- Password (add mode only) -->
                    <VBox fx:id="passwordSection" spacing="5">
                        <HBox spacing="2"><Label text="HASŁO" styleClass="field-label"/>
                            <Label text="*" styleClass="req"/></HBox>
                        <PasswordField fx:id="fieldHaslo" styleClass="field"
                                       promptText="Min. 8 znaków"/>
                    </VBox>

                    <!-- Form actions -->
                    <HBox styleClass="form-actions" alignment="CENTER_LEFT">
                        <Button text="Zachowaj wersję roboczą"
                                styleClass="btn,btn-ghost"/>
                        <Button fx:id="btnUsun" text="Usuń trenera"
                                styleClass="btn,btn-danger"
                                managed="false" visible="false"
                                onAction="#onUsun"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Anuluj" styleClass="btn,btn-ghost"
                                onAction="#onCancel"/>
                        <Button fx:id="btnSave" text="Zapisz"
                                styleClass="btn,btn-primary"
                                onAction="#onSave"/>
                    </HBox>
                </VBox>

                <!-- Avatar sidebar -->
                <VBox styleClass="card" prefWidth="180" alignment="TOP_CENTER"
                      spacing="12">
                    <Label text="ZDJĘCIE" styleClass="field-label"/>
                    <VBox styleClass="avatar-upload" alignment="CENTER"
                          spacing="6" onMouseClicked="#onChoosePhoto">
                        <Label text="📷" styleClass="avatar-upload-icon"/>
                        <Label text="Kliknij aby dodać"
                               styleClass="avatar-upload-text" wrapText="true"/>
                    </VBox>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
