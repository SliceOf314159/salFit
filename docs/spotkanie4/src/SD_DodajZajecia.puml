@startuml SD_DodajZajecia
title Diagram sekwencji — Dodanie zajęć z weryfikacją konfliktu (Epic 3)

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  FontColor #1a1f3c
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
}
skinparam sequence {
  ArrowColor #374151
  ArrowThickness 1.5
  LifeLineBorderColor #4338CA
  LifeLineBackgroundColor #E0E7FF
  DividerBackgroundColor #F0FDF4
  DividerBorderColor #16A34A
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

actor Administrator
boundary "GrafikView\n(FXML)" as View
control "GrafikController" as Controller
' Dialog otwierany jako osobny Stage z Modality.APPLICATION_MODAL
boundary "AddEditZajeciaDialog\n(FXML)" as Dialog
control "AddEditZajeciaDialogController" as DialogCtrl
entity "GrafikRepository" as GrafikRepo
entity "TrenerRepository" as TrenerRepo
entity "SalaRepository" as SalaRepo
database "grafik.json" as File

Administrator -> View       : kliknie "Dodaj zajęcia"
View          -> Controller : onDodajZajecia()

' openDialog() tworzy nowe okno modalne i wywołuje showAndWait()
Controller    -> Controller : openDialog("/views/dialogs/\nAddEditZajeciaDialog.fxml", "Dodanie zajęć")
Controller    -> Dialog     : new Stage(Modality.APPLICATION_MODAL)\nFXMLLoader.load(...)
Dialog        -> DialogCtrl : initialize()

note right of DialogCtrl
  Aktualnie ComboBox trenerzy/sale
  wypełniane są listami statycznymi.
  Po podłączeniu repozytoriów:
  findAktywni() i findByStatus(DOSTEPNA)
end note

' Docelowo — po podłączeniu repozytoriów
DialogCtrl    -> TrenerRepo : findAktywni()
TrenerRepo    --> DialogCtrl : List<Trener>
DialogCtrl    -> SalaRepo   : findByStatus(DOSTEPNA)
SalaRepo      --> DialogCtrl : List<Sala>
DialogCtrl    -> Dialog     : wypełnia ComboBox fieldTrener / fieldSala

Administrator -> Dialog     : wypełnia formularz\n(nazwa, rodzaj, trener, sala,\ndata, limit, czas, opis)
Administrator -> Dialog     : kliknie "Zapisz"
Dialog        -> DialogCtrl : onSave()

alt fieldNazwa jest puste
  DialogCtrl  --> Dialog    : return (formularz pozostaje otwarty)
  Dialog      --> Administrator : pole Nazwa pozostaje aktywne
else nazwa podana
  ' Weryfikacja konfliktu i zapis — do zaimplementowania po podłączeniu GrafikRepository
  DialogCtrl  -> GrafikRepo : findByTrener(trenerId)
  GrafikRepo  --> DialogCtrl : List<Zajecia>
  DialogCtrl  -> GrafikRepo : findBySala(salaId)
  GrafikRepo  --> DialogCtrl : List<Zajecia>
  DialogCtrl  -> DialogCtrl : sprawdzKonflikt(zajecia)

  alt konflikt istnieje
    DialogCtrl -> Dialog    : showAlert("Konflikt terminów")
    Dialog     --> Administrator : wyświetla alert
  else brak konfliktu
    DialogCtrl -> GrafikRepo : save(new Zajecia(formData))
    GrafikRepo -> GrafikRepo : generateId()
    GrafikRepo -> GrafikRepo : cache.add(zajecia)
    GrafikRepo -> File       : saveToFile() [JSON]
    File       --> GrafikRepo : OK
    GrafikRepo --> DialogCtrl : void
    DialogCtrl -> DialogCtrl : closeDialog() [stage.close()]
    Dialog     --> Controller : showAndWait() zwraca kontrolę
    Controller -> Controller : refresh()
    Controller -> Controller : renderTydzien(aktualnyTydzien)
    View       --> Administrator : wyświetla zaktualizowany grafik
  end
end

@enduml
