@startuml SD_TrenerGrafik
title Diagram sekwencji — Trener przegląda własny grafik (Epic 3)

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  FontColor #1a1f3c
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
}
skinparam sequence {
  ArrowColor #374151
  ArrowThickness 1.5
  LifeLineBorderColor #4338CA
  LifeLineBackgroundColor #E0E7FF
  DividerBackgroundColor #F0FDF4
  DividerBorderColor #16A34A
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

actor Trener
' Shell controller nawiguje do TrainerGrafikView przez FXMLLoader
control "TrainerShellController" as Shell
boundary "TrainerGrafikView\n(FXML)" as View
control "TrainerGrafikController" as Controller
entity "GrafikRepository" as GrafikRepo

Trener     -> Shell      : kliknie "Moje zajęcia"
Shell      -> Shell      : loadContent("TrainerGrafikView.fxml", btnMojeZajecia)
Shell      -> Shell      : updateActiveButton(btnMojeZajecia)
Shell      -> Controller : initialize() [przez FXMLLoader]
Controller -> Controller : aktualnyTydzien = LocalDate.now()
Controller -> Controller : refresh()
Controller -> Controller : poniedzialek = aktualnyTydzien.with(MONDAY)
Controller -> Controller : weekLabel.setText(...)

note right of Controller
  Docelowo: findByTrener(trenerId)
  Aktualnie: renderGrid() bez danych
  z repozytorium (stub)
end note

Controller -> GrafikRepo : findByTrener(trenerId)
GrafikRepo --> Controller : List<Zajecia>
Controller -> Controller  : renderGrid(monday)
View       --> Trener     : wyświetla pustą siatkę tygodniową\n(godz. × dni tygodnia)

Trener     -> View        : kliknie "Następny tydzień"
View       -> Controller  : onNastepny()
Controller -> Controller  : aktualnyTydzien = aktualnyTydzien.plusWeeks(1)
Controller -> Controller  : refresh()
Controller -> Controller  : renderGrid(monday)
View       --> Trener     : wyświetla zaktualizowany widok

' Przejście do listy uczestników wybranych zajęć
Trener     -> View        : kliknie "Uczestnicy zajęć"
View       -> Controller  : showUczestnicy()
Controller -> Shell       : TrainerShellController.getInstance().showUczestnicy()
Shell      -> Shell       : loadContent("TrainerUczestnicyView.fxml", btnMojeZajecia)
View       --> Trener     : wyświetla listę uczestników

@enduml
