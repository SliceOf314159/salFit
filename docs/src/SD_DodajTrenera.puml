@startuml SD_DodajTrenera
title Diagram sekwencji — Dodanie trenera (Epic 1)

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  FontColor #1a1f3c
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
}
skinparam sequence {
  ArrowColor #374151
  ArrowThickness 1.5
  LifeLineBorderColor #4338CA
  LifeLineBackgroundColor #E0E7FF
  DividerBackgroundColor #F0FDF4
  DividerBorderColor #16A34A
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

actor Administrator
boundary "TrenerView\n(FXML)" as View
control "TrenerController" as Controller
' Dialog otwierany jako osobny Stage z Modality.APPLICATION_MODAL
boundary "AddEditTrenerDialog\n(FXML)" as Dialog
control "AddEditTrenerDialogController" as DialogCtrl
entity "TrenerRepository" as Repo
database "trenerzy.json" as File

Administrator -> View       : kliknie "Dodaj trenera"
View          -> Controller : onDodajTrener()

' openDialog() tworzy nowe okno modalne i wywołuje showAndWait()
Controller    -> Controller : openDialog("/views/dialogs/\nAddEditTrenerDialog.fxml", "Dodanie trenera")
Controller    -> Dialog     : new Stage(Modality.APPLICATION_MODAL)\nFXMLLoader.load(...)
Dialog        -> DialogCtrl : initialize()
DialogCtrl    -> Dialog     : ustawia ComboBox Płeć i Poziom,\nwyświetla pusty formularz (tryb dodawania)

Administrator -> Dialog     : wypełnia formularz\n(imię, nazwisko, email,\ntelefon, specjalizacja, hasło)
Administrator -> Dialog     : kliknie "Zapisz"
Dialog        -> DialogCtrl : onSave()
DialogCtrl    -> DialogCtrl : validate()

alt validate() == false — puste wymagane pola
  DialogCtrl  --> Dialog    : return (formularz pozostaje otwarty)
  Dialog      --> Administrator : pola pozostają aktywne
else validate() == true
  ' Zapis do repozytorium — do zaimplementowania po podłączeniu TrenerRepository
  DialogCtrl  -> Repo       : save(new Trener(formData))
  Repo        -> Repo       : generateId()
  Repo        -> Repo       : cache.add(trener)
  Repo        -> File       : saveToFile() [JSON]
  File        --> Repo      : OK
  Repo        --> DialogCtrl : void
  DialogCtrl  -> DialogCtrl : closeDialog() [stage.close()]
  Dialog      --> Controller : showAndWait() zwraca kontrolę
  Controller  -> Controller : refresh()
  Controller  -> Controller : loadData() [stub]
  View        --> Administrator : wyświetla zaktualizowaną listę
end

@enduml
