@startuml CD_Controllers
top to bottom direction
title Diagram klas — warstwa kontrolerów (JavaFX Controllers)

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  HeaderBackgroundColor #C7D2FE
  HeaderFontColor #1a1f3c
  FontColor #1a1f3c
  BorderThickness 1.5
}
skinparam package {
  BackgroundColor #F5F7FF
  BorderColor #818CF8
  FontColor #1a1f3c
  BorderThickness 1.2
}
skinparam arrow {
  Color #374151
  Thickness 1.5
}

' ─── Navigation / Auth ───────────────────────────────────────────────────────
package "Nawigacja / Auth" {
  class SceneManager << (S,#FCA5A5) singleton >> {
    - Stage stage
    --
    + void init(Stage stage)
    + Stage getStage()
    + void showLogin()
    + void showForgotPassword()
    + void showChangePassword()
    + void showAdminShell()
    + void showTrainerShell()
    - void loadScene(String fxmlPath)
  }

  class LoginController {
    --
    + void loginAdmin()
    + void loginTrainer()
    + void goForgotPassword()
    - void showError(Label lbl, String msg)
    - void hideError(Label lbl)
  }

  class ForgotPasswordController {
    --
    + void submitReset()
    + void goLogin()
  }

  class ChangePasswordController {
    --
    + void updateStrength()
    + void submitChange()
    + void goLogin()
    - void showError(String msg)
    - void hideError()
  }

  LoginController          ..> SceneManager : uses
  ForgotPasswordController ..> SceneManager : uses
  ChangePasswordController ..> SceneManager : uses
}

' ─── Admin shell ─────────────────────────────────────────────────────────────
class MainController << (S,#FCA5A5) singleton >> {
  - StackPane contentArea
  - Button activeButton
  --
  + void initialize()
  + void showTrenerView()
  + void showSalaView()
  + void showGrafikView()
  + void showCzlonekView()
  + void showKarnetView()
  + void showRaportView()
  + void logout()
  + void goChangePassword()
  + void loadContent(String fxmlPath, Button activeBtn)
  - void updateActiveButton(Button active)
}

SceneManager ..> MainController : instantiates

' ─── Trener (admin) ──────────────────────────────────────────────────────────
package "Trener" {
  class TrenerController {
    - TableView<Object> trenerTable
    - TextField searchField
    --
    + void initialize()
    + void refresh()
    + void onSearch()
    + void onDodajTrener()
    - void onEdytujTrener()
    - void onToggleAktywny()
    - void loadData()
    - void openDialog(String fxmlPath, String title)
    - void setupColumns()
  }

  class AddEditTrenerDialogController {
    - boolean editMode
    --
    + void initialize()
    + void setEditMode(boolean edit)
    - void onSave()
    - void onUsun()
    - void onCancel()
    - void onChoosePhoto()
    - boolean validate()
    - void closeDialog()
  }

  class TrenerRepository << (S,#FCA5A5) singleton >>
  TrenerController ..> TrenerRepository : uses
  TrenerController ..> AddEditTrenerDialogController : opens dialog
}

' ─── Sala ────────────────────────────────────────────────────────────────────
package "Sala" {
  class SalaController {
    - TableView<Object> salaTable
    - TextField searchField
    --
    + void initialize()
    + void refresh()
    + void onSearch()
    + void onDodajSale()
    - void onEdytujSale()
    - void onZmienStatus()
    - void loadData()
    - void openDialog(String path, String title)
    - void setupColumns()
  }

  class AddEditSalaDialogController {
    --
    + void initialize()
    + void setEditMode(boolean edit)
    - void onSave()
    - void onUsun()
    - void onCancel()
    - void stepUp()
    - void stepDown()
    - void stepPrzerwaUp()
    - void stepPrzerwaDown()
    - void step(TextField field, int delta)
    - void closeDialog()
  }

  class SalaRepository << (S,#FCA5A5) singleton >>
  SalaController ..> SalaRepository : uses
  SalaController ..> AddEditSalaDialogController : opens dialog
}

' ─── Grafik (admin) ──────────────────────────────────────────────────────────
package "Grafik" {
  class GrafikController {
    - GridPane grafikGrid
    - Label weekLabel
    - LocalDate aktualnyTydzien
    --
    + void initialize()
    + void refresh()
    + void onPoprzedniTydzien()
    + void onNastepnyTydzien()
    + void onDodajZajecia()
    - void renderTydzien(LocalDate monday)
    - Label makeHeaderCell(String text)
    - RowConstraints rowConst(double height)
  }

  class AddEditZajeciaDialogController {
    --
    + void initialize()
    - void onSave()
    - void onCancel()
    - void stepLimitUp()
    - void stepLimitDown()
    - void stepCzasUp()
    - void stepCzasDown()
    - void step(TextField field, int delta)
    - void closeDialog()
  }

  class GrafikRepository << (S,#FCA5A5) singleton >>
  class "TrenerRepository " as GrafTrenerRepo << (S,#FCA5A5) singleton >>
  class "SalaRepository "   as GrafSalaRepo  << (S,#FCA5A5) singleton >>
  GrafikController ..> GrafikRepository : uses
  GrafikController ..> GrafTrenerRepo   : uses
  GrafikController ..> GrafSalaRepo     : uses
  GrafikController ..> AddEditZajeciaDialogController : opens dialog
}

' ─── Czlonek ─────────────────────────────────────────────────────────────────
package "Czlonek" {
  class CzlonekController {
    - TableView<Object> czlonekTable
    - TableView<Object> karnetTable
    - TextField searchMembers
    - TextField searchPasses
    --
    + void initialize()
    + void refresh()
    + void showMembersTab()
    + void showPassesTab()
    + void onSearchMembers()
    + void onSearchPasses()
    + void onDodajCzlonka()
    - void onEdytujCzlonka()
    + void onSprzedajKarnet()
    - void onPrzedluzKarnet()
    - void loadData()
    - void setupMemberColumns()
    - void setupPassColumns()
    - void openDialog(String path, String title)
  }

  class AddEditCzlonekDialogController {
    --
    + void initialize()
    + void setEditMode(boolean edit)
    - void onSave()
    - void onCancel()
    - void onChoosePhoto()
    - void closeDialog()
  }

  class SprzedajKarnetDialogController {
    - YearMonth displayedMonth
    --
    + void initialize()
    - void onRodzajChanged()
    - void onDataOdChanged()
    - void prevMonth()
    - void nextMonth()
    - void renderCalendar()
    - void onNowyCzlonek()
    - void onSprzedaj()
    - void onPrzedluz()
    - void onCancel()
    - void closeDialog()
  }

  class CzlonekRepository << (S,#FCA5A5) singleton >>
  CzlonekController ..> CzlonekRepository : uses
  CzlonekController ..> AddEditCzlonekDialogController : opens dialog
  CzlonekController ..> SprzedajKarnetDialogController : opens dialog
}

' ─── Raport ──────────────────────────────────────────────────────────────────
package "Raport" {
  class RaportController {
    --
    + void initialize()
    + void refresh()
    + void onEksportCSV()
    + void onEksportTXT()
    - Map<String,Double> obliczOblozenieSal()
    - Map<String,Integer> obliczAktywnosc()
    - List<Karnet> pobierzWygasajace()
  }
  class "GrafikRepository "  as RapGrafikRepo  << (S,#FCA5A5) singleton >>
  class "SalaRepository "    as RapSalaRepo    << (S,#FCA5A5) singleton >>
  class "TrenerRepository "  as RapTrenerRepo  << (S,#FCA5A5) singleton >>
  class "CzlonekRepository " as RapCzlonekRepo << (S,#FCA5A5) singleton >>
  RaportController ..> RapGrafikRepo  : uses
  RaportController ..> RapSalaRepo    : uses
  RaportController ..> RapTrenerRepo  : uses
  RaportController ..> RapCzlonekRepo : uses
}

' ─── Trainer shell ───────────────────────────────────────────────────────────
package "Trener (widok trenera)" {
  class TrainerShellController << (S,#FCA5A5) singleton >> {
    - StackPane contentArea
    - Button activeButton
    --
    + void initialize()
    + void showGrafik()
    + void showProfil()
    + void showAktywnosc()
    + void showUczestnicy()
    + void logout()
    + void goChangePassword()
    + void loadContent(String fxmlPath, Button activeBtn)
    - void updateActiveButton(Button active)
  }

  class TrainerGrafikController {
    - GridPane grafikGrid
    - Label weekLabel
    - LocalDate aktualnyTydzien
    --
    + void initialize()
    + void onPoprzedni()
    + void onNastepny()
    + void showUczestnicy()
    - void refresh()
    - void renderGrid(LocalDate monday)
    - Label makeHeaderCell(String text)
    - RowConstraints rowConst(double h)
  }

  class TrainerProfilController {
    --
    + void initialize()
  }

  class TrainerAktywnoscController {
    - ComboBox<String> monthSelector
    --
    + void initialize()
    - void populateMonthSelector()
    - void loadData()
    - void onMonthChanged()
  }

  class TrainerUczestnicyController {
    - TableView<Object> uczestnicyTable
    --
    + void initialize()
    - void setupColumns()
    - void loadData()
    - void backToGrafik()
  }

  class "GrafikRepository " as TrGrafikRepo << (S,#FCA5A5) singleton >>
  TrainerShellController ..> TrainerGrafikController     : loads
  TrainerShellController ..> TrainerProfilController     : loads
  TrainerShellController ..> TrainerAktywnoscController  : loads
  TrainerShellController ..> TrainerUczestnicyController : loads
  TrainerGrafikController   ..> TrGrafikRepo             : uses
  TrainerUczestnicyController ..> TrainerShellController : backToGrafik()
}

SceneManager ..> TrainerShellController : instantiates

' ─── Admin navigation ────────────────────────────────────────────────────────
MainController ..> TrenerController  : loads
MainController ..> SalaController    : loads
MainController ..> GrafikController  : loads
MainController ..> CzlonekController : loads
MainController ..> RaportController  : loads

@enduml
