@startuml SD_SprzedajKarnet
title Diagram sekwencji — Sprzedaż karnetu (Epic 4)

skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
  FontColor #1a1f3c
}
skinparam actor {
  BackgroundColor #EEF2FF
  BorderColor #4338CA
}
skinparam sequence {
  ArrowColor #374151
  ArrowThickness 1.5
  LifeLineBorderColor #4338CA
  LifeLineBackgroundColor #E0E7FF
  DividerBackgroundColor #F0FDF4
  DividerBorderColor #16A34A
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
}

actor Administrator
boundary "CzlonekView\n(FXML)" as View
control "CzlonekController" as Controller
' Dialog otwierany jako osobny Stage z Modality.APPLICATION_MODAL
boundary "SprzedajKarnetDialog\n(FXML)" as Dialog
control "SprzedajKarnetDialogController" as DialogCtrl
entity "CzlonekRepository" as Repo
database "czlonkowie.json\nkarnety.json" as File

Administrator -> View       : kliknie "Sprzedaj karnet"
View          -> Controller : onSprzedajKarnet()

' openDialog() tworzy nowe okno modalne i wywołuje showAndWait()
Controller    -> Controller : openDialog("/views/dialogs/\nSprzedajKarnetDialog.fxml", "Sprzedaż karnetu")
Controller    -> Dialog     : new Stage(Modality.APPLICATION_MODAL)\nFXMLLoader.load(...)
Dialog        -> DialogCtrl : initialize()

' Docelowo — po podłączeniu CzlonekRepository
DialogCtrl    -> Repo       : findAll()
Repo          --> DialogCtrl : List<Czlonek>
DialogCtrl    -> Dialog     : wypełnia ComboBox fieldCzlonek\ndataOd = LocalDate.now()\nwyświetla mini-kalendarz renderCalendar()

Administrator -> Dialog     : wybiera rodzaj karnetu
Dialog        -> DialogCtrl : onRodzajChanged()

note right of DialogCtrl
  Inline switch expression:
  "Miesięczny" → dataOd +30 dni
  "Kwartalny"  → dataOd +90 dni
  "Roczny"     → dataOd +365 dni
end note

DialogCtrl    -> Dialog     : aktualizuje fieldDataDo

Administrator -> Dialog     : klika dzień w mini-kalendarzu
Dialog        -> DialogCtrl : onDataOdChanged() → onRodzajChanged()
DialogCtrl    -> Dialog     : aktualizuje fieldDataDo

Administrator -> Dialog     : kliknie "Sprzedaj"
Dialog        -> DialogCtrl : onSprzedaj()

' Zapis — do zaimplementowania po podłączeniu CzlonekRepository
DialogCtrl    -> Repo       : saveKarnet(new Karnet(czlonekId, rodzaj, dataOd, dataDo))
Repo          -> Repo       : generateId()
Repo          -> Repo       : cacheKarnety.add(karnet)
Repo          -> File       : saveToFile() [karnety.json]
File          --> Repo      : OK
Repo          --> DialogCtrl : void
DialogCtrl    -> DialogCtrl : closeDialog() [stage.close()]
Dialog        --> Controller : showAndWait() zwraca kontrolę
Controller    -> Controller : refresh()
Controller    -> Controller : loadData() [stub]
View          --> Administrator : wyświetla zaktualizowaną listę\nze statusem karnetu

@enduml
